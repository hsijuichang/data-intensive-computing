        "# Set up Spark session \n",
        "builder = (\n",
        "    SparkSession.builder\n",
        "    .appName(\"Lab1-Task1-Data-Catalog\")\n",
        "    .master(\"local[4]\")\n",
        "    .config(\"spark.driver.memory\", \"3g\")\n",
        "    .config(\"spark.sql.shuffle.partitions\", \"64\")\n",
        "    .config(\"spark.local.dir\", os.environ[\"SPARK_LOCAL_DIRS\"])\n",
        "    .config(\"spark.driver.extraJavaOptions\", f'-Djava.io.tmpdir={os.environ[\"SPARK_JAVA_TMP_DIR\"]}')\n",
        "    .config(\"spark.jars.ivy\", os.environ[\"SPARK_IVY_DIR\"])\n",
        "    .config(\"spark.sql.warehouse.dir\", os.environ[\"SPARK_WAREHOUSE_DIR\"])\n",
