      "source": [
        "# Check candidate keys for each dataset\n",
        "def check_candidate_key(df, dataset_name, key_columns):\n",
        "    missing_conditions = [\n",
        "        F.col(column).isNull() | (F.trim(F.col(column).cast(\"string\")) == \"\")\n",
        "        for column in key_columns\n",
        "    ]\n",
        "    missing_key_rows = df.filter(reduce(lambda left, right: left | right, missing_conditions)).count()\n",
        "    duplicate_groups = (\n",
        "        df.groupBy(*key_columns).count().filter(F.col(\"count\") > 1)\n",
        "    )\n",
        "    result = {\n",
        "        \"dataset\": dataset_name,\n",
        "        \"candidate_key\": \" + \".join(key_columns),\n",
        "        \"missing_key_rows\": missing_key_rows,\n",
        "        \"duplicate_key_groups\": duplicate_groups.count(),\n",
        "    }\n",
        "    print(result)\n",
        "    duplicate_groups.orderBy(F.desc(\"count\")).show(10, truncate=False)\n",
        "    return result\n",
        "\n",
        "weather_for_key = weather.withColumn(\n",
        "    \"_catalog_observation_timestamp\",\n",
        "    F.make_timestamp(\"year\", \"month\", \"day\", \"hour\", F.lit(0), F.lit(0)),\n",
        ")\n",
        "air_for_key = air_quality.withColumn(\n",
        "    \"_catalog_observation_timestamp\",\n",
        "    F.to_timestamp(F.concat_ws(\" \", F.col(\"Date Local\"), F.col(\"Time Local\")), \"yyyy-MM-dd HH:mm\"),\n",
        ")"
      ],
