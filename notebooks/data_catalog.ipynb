      "source": [
        "import subprocess\n",
        "import textwrap\n",
        "try:\n",
        "    from PIL import Image, ImageDraw, ImageFont\n",
        "except ModuleNotFoundError:\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"Pillow\"])\n",
        "    from PIL import Image, ImageDraw, ImageFont\n",
        "from IPython.display import Image as NotebookImage, display as notebook_display\n",
        "\n",
        "catalog_headers = [\n",
        "    \"Dataset\", \"Primary entity\", \"Primary key\", \"Join attributes\",\n",
        "    \"Temporal attributes\", \"Categorical attributes\", \"Growth over time\",\n",
        "]\n",
        "catalog_image_rows = []\n",
        "for catalog_record in data_catalog.collect():\n",
        "    catalog_image_rows.append([\n",
        "        catalog_record.dataset,\n",
        "        catalog_record.primary_entity,\n",
        "        catalog_record.primary_key,\n",
        "        \", \".join(catalog_record.join_attributes) if catalog_record.join_attributes else \"None\",\n",
        "        \", \".join(catalog_record.temporal_attributes) if catalog_record.temporal_attributes else \"None\",\n",
        "        \", \".join(catalog_record.categorical_attributes) if catalog_record.categorical_attributes else \"None\",\n",
        "        catalog_record.growth_over_time,\n",
        "    ])\n",
        "\n",
        "column_widths = [260, 410, 720, 520, 520, 790, 610]\n",
        "margin = 70\n",
        "title_height = 105\n",
        "header_height = 86\n",
        "cell_padding_x = 18\n",
        "cell_padding_y = 18\n",
        "line_height = 32\n",
        "regular_font_path = \"/System/Library/Fonts/Supplemental/Arial.ttf\"\n",
        "bold_font_path = \"/System/Library/Fonts/Supplemental/Arial Bold.ttf\"\n",
        "title_font = ImageFont.truetype(bold_font_path, 46)\n",
        "header_font = ImageFont.truetype(bold_font_path, 25)\n",
        "body_font = ImageFont.truetype(regular_font_path, 24)\n",
        "dataset_font = ImageFont.truetype(bold_font_path, 25)\n",
        "\n",
        "def wrap_catalog_cell(value, width, font):\n",
        "    average_character_width = max(\n",
        "        font.getlength(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\") / 52, 1\n",
        "    )\n",
        "    maximum_characters = max(8, int((width - 2 * cell_padding_x) / average_character_width))\n",
        "    wrapped_lines = []\n",
        "    for paragraph in str(value).splitlines() or [\"\"]:\n",
        "        wrapped_lines.extend(\n",
        "            textwrap.wrap(\n",
        "                paragraph, width=maximum_characters,\n",
        "                break_long_words=False, break_on_hyphens=False,\n",
        "            ) or [\"\"]\n",
        "        )\n",
        "    return wrapped_lines\n",
        "\n",
        "wrapped_catalog_rows = []\n",
        "catalog_row_heights = []\n",
        "for catalog_row in catalog_image_rows:\n",
        "    wrapped_row = [\n",
        "        wrap_catalog_cell(value, width, dataset_font if column_index == 0 else body_font)\n",
        "        for column_index, (value, width) in enumerate(zip(catalog_row, column_widths))\n",
        "    ]\n",
        "    wrapped_catalog_rows.append(wrapped_row)\n",
        "    catalog_row_heights.append(\n",
        "        max(len(lines) for lines in wrapped_row) * line_height + 2 * cell_padding_y\n",
        "    )\n",
        "\n",
        "canvas_width = 2 * margin + sum(column_widths)\n",
        "canvas_height = 2 * margin + title_height + header_height + sum(catalog_row_heights)\n",
        "catalog_image = Image.new(\"RGB\", (canvas_width, canvas_height), \"#F7F9FC\")\n",
        "catalog_draw = ImageDraw.Draw(catalog_image)\n",
        "catalog_draw.text((margin, margin), \"Week 1 - Task 1 Data Catalog\", font=title_font, fill=\"#172033\")\n",
        "\n",
        "current_y = margin + title_height\n",
        "current_x = margin\n",
        "for header, width in zip(catalog_headers, column_widths):\n",
        "    catalog_draw.rectangle(\n",
        "        (current_x, current_y, current_x + width, current_y + header_height),\n",
        "        fill=\"#173F5F\", outline=\"#D6DEE8\", width=2,\n",
        "    )\n",
        "    header_lines = wrap_catalog_cell(header, width, header_font)\n",
        "    header_y = current_y + (header_height - len(header_lines) * line_height) / 2\n",
        "    for header_line in header_lines:\n",
        "        catalog_draw.text((current_x + cell_padding_x, header_y), header_line, font=header_font, fill=\"white\")\n",
        "        header_y += line_height\n",
        "    current_x += width\n",
        "\n",
        "current_y += header_height\n",
        "for row_index, (wrapped_row, row_height) in enumerate(zip(wrapped_catalog_rows, catalog_row_heights)):\n",
        "    row_fill = \"#FFFFFF\" if row_index % 2 == 0 else \"#EDF3F8\"\n",
        "    current_x = margin\n",
        "    for column_index, (cell_lines, width) in enumerate(zip(wrapped_row, column_widths)):\n",
        "        catalog_draw.rectangle(\n",
        "            (current_x, current_y, current_x + width, current_y + row_height),\n",
        "            fill=row_fill, outline=\"#CCD6E1\", width=2,\n",
        "        )\n",
        "        cell_font = dataset_font if column_index == 0 else body_font\n",
        "        cell_y = current_y + cell_padding_y\n",
        "        for cell_line in cell_lines:\n",
        "            catalog_draw.text((current_x + cell_padding_x, cell_y), cell_line, font=cell_font, fill=\"#172033\")\n",
        "            cell_y += line_height\n",
        "        current_x += width\n",
        "    current_y += row_height\n",
        "\n",
        "report_directory = PROJECT_ROOT / \"reports\"\n",
        "report_directory.mkdir(parents=True, exist_ok=True)\n",
        "catalog_image_path = report_directory / \"data_catalog.png\"\n",
        "catalog_image.save(catalog_image_path, format=\"PNG\", optimize=True)\n",
        "print(f\"Saved catalog image: {catalog_image_path}\")\n",
        "notebook_display(NotebookImage(filename=str(catalog_image_path)))"
      ],
      "execution_count": 8,
